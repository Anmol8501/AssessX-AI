# Copy to .env for local development. Never commit .env.
APP_ENV=development                 # development | test | production
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL from infrastructure/docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://assessx:assessx@localhost:5433/assessx
TEST_DATABASE_URL=postgresql+psycopg://assessx:assessx@localhost:5433/assessx_test
# Provider URLs (postgres://… / postgresql://…) are accepted as given; the psycopg 3 driver is pinned.
# Connection pool per process (defaults 5 / 10). Keep small for a hosted pooler, e.g. Supabase Free: 3 / 2.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Any long random string; keys the server-side session-token hashing. Rotating it signs everyone out.
# With APP_ENV=production it must be at least 32 characters and not this placeholder (startup refuses).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-only

# Comma-separated origins allowed to call the API (Vite dev server + Tauri webview). Never '*' in production.
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost

SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30
LOGIN_CHALLENGE_TTL_SECONDS=300

LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Phase 7B — AI answer evaluation (server-side only; never put a key in the desktop app).
# none (default): answers are recorded as not evaluated. anthropic: needs LLM_API_KEY.
# stub: a labelled deterministic test double for development/E2E only — refused in production.
# LLM_PROVIDER=none
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
# EVALUATION_WAIT_SECONDS=25
# LOG_FORMAT=console                # console (default outside production) | json (default in production)

# Coding assessments (stage C2). The code runner is a separate program on a separate machine
# (see runner/README.md); it never runs on this API. RUNNER_TOKEN is its shared secret (≥ 32 chars in
# production) — unset keeps the runner routes off. CODING_EXECUTION_ENABLED=true lets assessments with
# coding questions be published; set it only when a runner is running.
# RUNNER_TOKEN=
# CODING_EXECUTION_ENABLED=false

# Evidence clips (FR-017; docs/EVIDENCE-CLIPS.md). On by default outside production, stored under
# backend/var/evidence (git-ignored). Production needs a PRIVATE Supabase bucket and the service-role
# key (server-only, never in the desktop app).
# EVIDENCE_CLIPS_ENABLED=
# EVIDENCE_RETENTION_DAYS=30
# EVIDENCE_STORAGE_BACKEND=local
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Security operations (docs/SECURITY-OPERATIONS.md). Placeholders only: real values are Render secrets.
# ALERT_WEBHOOK_URL=            # https Slack/Discord/ntfy webhook for security alerts
# CLIENT_IP_HEADER=cf-connecting-ip   # on Render (Cloudflare edge)
# MAINTENANCE_TOKEN=            # 32+ random characters; same value as the GitHub secret
# ADMIN_MFA_REQUIRED=           # empty = required in production (false is refused there)
# ADMIN_SESSION_TTL_HOURS=12
# BACKUP_MAX_AGE_HOURS=26
# Retention in days (0 = keep): docs/DATA-RETENTION.md
# RETENTION_ATTEMPT_DAYS=1095
# RETENTION_PROCTORING_EVENT_DAYS=365
# RETENTION_SECURITY_EVENT_DAYS=365
# RETENTION_SESSION_DAYS=30
