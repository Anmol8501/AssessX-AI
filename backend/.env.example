# Copy to .env for local development. Never commit .env.
APP_ENV=development                 # development | test | production
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL from infrastructure/docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://assessx:assessx@localhost:5433/assessx
TEST_DATABASE_URL=postgresql+psycopg://assessx:assessx@localhost:5433/assessx_test

# Any long random string; keys the server-side session-token hashing. Rotating it signs everyone out.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-development-only

# Comma-separated origins allowed to call the API (Vite dev server + Tauri webview).
CORS_ORIGINS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost

SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30
LOGIN_CHALLENGE_TTL_SECONDS=300

LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=console                # console (default outside production) | json (default in production)
