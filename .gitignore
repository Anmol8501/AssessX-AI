# Secrets and local configuration
.env
.env.*
!.env.example
!.env.development
!.env.production.example
# The website's production build settings: public values only (download URL/flag), committed so
# Cloudflare's build can read them. Never put secrets in it.
!apps/web/.env.production
*.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# Tauri / Rust build output
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/schemas/

# Test artefacts
test-results/
playwright-report/
coverage/
htmlcov/

# Logs and temporary files
*.log
logs/
*.tmp
*.bak

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Phase 8B: never commit signing keys, certificates with private keys, or database backups.
*.key
*.pem
*.p12
*.pfx
*.dump
*.dump.gpg
*.dump.gpg.sha256
assessx-backups/

# Evidence clips stored locally in development (camera video): never commit.
backend/var/
*.webm
*.mp4
*.mkv

# Phase 8 final: SSH keys, credential stores and local secret files.
id_rsa*
id_ed25519*
id_ecdsa*
*.keystore
*.jks
.env.*
!.env.example
!.env.*.example
# Tracked on purpose: public, non-secret build settings only.
!apps/desktop/.env.development
!apps/web/.env.production
secrets/
