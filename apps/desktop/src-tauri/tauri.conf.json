{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssessX",
  "version": "0.1.3",
  "identifier": "com.assessx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AssessX",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://assessx-backend-0nw6.onrender.com wss://assessx-backend-0nw6.onrender.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third-party/YOLOX-LICENSE.txt": "third-party/YOLOX-LICENSE.txt",
      "../third-party/onnxruntime-LICENSE.txt": "third-party/onnxruntime-LICENSE.txt",
      "../third-party/onnxruntime-ThirdPartyNotices.txt": "third-party/onnxruntime-ThirdPartyNotices.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3Q0E5MEJCQzE0NUFFMkEKUldRcXJrWEJ1NURLSjdWM0hBSVJXaC9MdGtNVkRFdUNPZWZWUHZLdlNkZE1Jb2o1MUVqYUNvMGIK",
      "endpoints": ["https://github.com/Anmol8501/AssessX-AI/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
