{
  "name": "desktop",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/fetch-ai-assets.mjs --mode=dev",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-production-bundle.mjs",
    "prebuild": "node scripts/fetch-ai-assets.mjs --mode=build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "release:build": "node scripts/release-build.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "calibrate:objects": "playwright test --config benchmarks/webcam/playwright.config.ts objects-calibration"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "codemirror": "^6.0.2",
    "onnxruntime-web": "1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
