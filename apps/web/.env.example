# Copy to .env.local and adjust. All values are optional.

# Where the "Download for Windows" buttons point.
# Default: /downloads/AssessX-Setup.exe (served from public/downloads/)
VITE_ASSESSX_DOWNLOAD_URL=/downloads/AssessX-Setup.exe

# Set to "true" once a real installer exists at the URL above.
# While false, download buttons render in a disabled "coming soon" state
# instead of pointing at a file that does not exist.
VITE_ASSESSX_DOWNLOAD_AVAILABLE=false
