// Cloudflare Workers configuration for the AssessX marketing website (static assets only).
//
// Used by Workers Builds for both deploy paths (root directory /apps/web, build `npm run build`):
//   * production (main):        npx wrangler deploy
//   * previews (other branches): npx wrangler preview  — requires the `previews` block below
//
// This reproduces what Wrangler's automatic configuration used for production before this file
// existed (static Vite output, single-page-application fallback, observability on), and names the
// Worker explicitly. No Worker script: the built `dist/` is served as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assessx-ai",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Enables `wrangler preview` (Worker Previews, open beta). May be empty; assets and
  // compatibility settings stay at the top level.
  "previews": {}
}
